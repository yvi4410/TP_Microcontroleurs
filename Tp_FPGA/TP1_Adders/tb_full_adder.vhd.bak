library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity tb_full_adder_1_bit is
end tb_full_adder_1_bit;

architecture tb of tb_full_adder_1_bit is

    -- Signaux de test
    signal A, B, Cin : std_logic;
    signal S, Cout   : std_logic;

begin

    -- Instanciation de l’additionneur complet
    UUT : entity work.full_adder_1_bit
        port map (
            a    => A,
            b    => B,
            Cin  => Cin,
            s    => S,
            Cout => Cout
        );

    -- Processus de test
    stimulus : process
    begin

        -- Cas 000 => S=0, Cout=0
        A <= '0'; B <= '0'; Cin <= '0';
        wait for 10 ns;
        assert (S = '0') report "Erreur somme (0+0+0)" severity error;
        assert (Cout = '0') report "Erreur retenue (0+0+0)" severity error;

        -- Cas 001 => S=1, Cout=0
        A <= '0'; B <= '0'; Cin <= '1';
        wait for 10 ns;
        assert (S = '1') report "Erreur somme (0+0+1)" severity error;
        assert (Cout = '0') report "Erreur retenue (0+0+1)" severity error;

        -- Cas 010 => S=1, Cout=0
        A <= '0'; B <= '1'; Cin <= '0';
        wait for 10 ns;
        assert (S = '1') report "Erreur somme (0+1+0)" severity error;
        assert (Cout = '0') report "Erreur retenue (0+1+0)" severity error;

        -- Cas 011 => S=0, Cout=1
        A <= '0'; B <= '1'; Cin <= '1';
        wait for 10 ns;
        assert (S = '0') report "Erreur somme (0+1+1)" severity error;
        assert (Cout = '1') report "Erreur retenue (0+1+1)" severity error;

        -- Cas 100 => S=1, Cout=0
        A <= '1'; B <= '0'; Cin <= '0';
        wait for 10 ns;
        assert (S = '1') report "Erreur somme (1+0+0)" severity error;
        assert (Cout = '0') report "Erreur retenue (1+0+0)" severity error;

        -- Cas 101 => S=0, Cout=1
        A <= '1'; B <= '0'; Cin <= '1';
        wait for 10 ns;
        assert (S = '0') report "Erreur somme (1+0+1)" severity error;
        assert (Cout = '1') report "Erreur retenue (1+0+1)" severity error;

        -- Cas 110 => S=0, Cout=1
        A <= '1'; B <= '1'; Cin <= '0';
        wait for 10 ns;
        assert (S = '0') report "Erreur somme (1+1+0)" severity error;
        assert (Cout = '1') report "Erreur retenue (1+1+0)" severity error;

        -- Cas 111 => S=1, Cout=1
        A <= '1'; B <= '1'; Cin <= '1';
        wait for 10 ns;
        assert (S = '1') report "Erreur somme (1+1+1)" severity error;
        assert (Cout = '1') report "Erreur retenue (1+1+1)" severity error;

        wait;

    end process;

end architecture;