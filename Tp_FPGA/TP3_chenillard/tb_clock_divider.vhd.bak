--====================================================================
--  File       : tb_clock_divider.vhd
--  Author     : <votre nom>
--  Purpose    : Testbench pour clock_divider
--====================================================================
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;  -- pour type std_logic_vector

entity tb_clock_divider is
end entity tb_clock_divider;

architecture tb of tb_clock_divider is
    -- Signaux de test
    signal CLKin  : std_logic := '0';
    signal RST    : std_logic;
    signal N      : std_logic_vector(4 downto 0);
    signal CLKout : std_logic;
begin
    -- Instanciation de l'UUT
    UUT: entity work.clock_divider
        port map(
            CLKin  => CLKin,
            RST    => RST,
            N      => N,
            CLKout => CLKout
        );

    -- Générateur d'horloge 50 MHz (periode 10 ns)
    proc_clock: process
    begin
        CLKin <= not CLKin;
        wait for 5 ns;
    end process proc_clock;

    -- Stimuli des entrées
    proc_inputs: process
    begin
        -- Valeur de division choisie (par exemple N = 7)
        N <= "00111";
        -- Reset asynchrone actif bas
        RST <= '0';
        wait for 50 ns;
        RST <= '1';
        -- Laisser tourner quelques cycles
        wait for 500 ns;
        -- Fin de simulation
        wait;
    end process proc_inputs;
end architecture tb;
﻿